{
  "name": "ntu-ai-medical-evaluation-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "data:profile": "node scripts/profile-dataset.mjs",
    "data:mimic-pilot": "python scripts/build-mimic-hosp-pilot.py ../hosp.zip .data/derived/mimic-hosp-bp-pilot-100.zip --limit 100",
    "data:import-mimic-pilot": "node scripts/import-local-derived-dataset.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "^0.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.3.0",
    "vite": "6.4.2"
  }
}
